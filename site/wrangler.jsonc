// For Workers Builds, which runs `npx wrangler deploy` on pushes to main and `npx wrangler preview` on other
// branches. Plain Wrangler reads this file, not cloudflare.config.ts, and refuses to publish a preview without a
// `previews` block. `npx cf deploy` from a Mac reads cloudflare.config.ts, so keep the name, date, entry, assets and
// bindings here in step with it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hyperpoint",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/download", "/download/*", "/appcast.xml"]
  },
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "hyperpoint-releases" }],
  "workers_dev": false,
  "preview_urls": true,
  // Previews inherit no bindings. They read the same bucket, since the Worker only reads it and a preview should
  // serve the real releases.
  "previews": {
    "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "hyperpoint-releases" }]
  }
}
