// For `npx wrangler preview`, which Workers Builds runs on branch pushes. Plain Wrangler reads this file, not
// cloudflare.config.ts, and refuses to publish a preview without a `previews` block. `npx cf deploy` still deploys
// from cloudflare.config.ts, so keep the name, date, entry, assets and bindings here in step with it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hyperpoint",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/download", "/download/*"]
  },
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "hyperpoint-releases" }],
  "workers_dev": false,
  "preview_urls": true,
  "previews": {}
}
