{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4319", "--directory", "site/public"],
      "port": 4319
    },
    {
      "name": "site-worker",
      "runtimeExecutable": "site/node_modules/.bin/wrangler",
      "runtimeArgs": ["dev", "-c", "site/wrangler.jsonc", "--port", "8787", "--persist-to", "site/.wrangler/state"],
      "port": 8787
    }
  ]
}
